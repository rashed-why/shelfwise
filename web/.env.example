# Copy to .env.local and adjust values:
#   cp .env.example .env.local

# NextAuth session encryption (required)
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-change-in-production

# Nest API URL for Next.js rewrites (/backend → API)
API_URL=http://localhost:4000

# Optional — browser calls API directly instead of /backend proxy
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
